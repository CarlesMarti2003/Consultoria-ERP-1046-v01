<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AS_IS" targetNamespace="https://nexe.example/processos">
  <bpmn:process id="Process_AS_IS" name="Aprovisionament actual" isExecutable="false">
    <bpmn:startEvent id="start" name="Necessitat de material">

      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="need" name="Identificar necessitats">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="stock" name="Comprovar full d’estoc">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="stock_ok" name="Hi ha estoc?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="stock_end" name="Material disponible">
      <bpmn:incoming>f4</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="request" name="Preparar sol·licitud">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="order" name="Triar proveïdor i fer comanda">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="follow" name="Seguir lliurament">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="receive" name="Rebre material">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="qty_ok" name="Quantitat correcta?">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="qty_issue" name="Comunicar diferència">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="qty_end" name="Pendent de regularitzar">
      <bpmn:incoming>f11</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="quality" name="Comprovar qualitat">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="quality_ok" name="Lot acceptat?">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="reject" name="Comunicar rebuig">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="reject_end" name="Lot rebutjat">
      <bpmn:incoming>f15</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="quality_pending" name="Mantindre en revisió">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="quality_pending_end" name="Pendent de qualitat">
      <bpmn:incoming>f19</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="register" name="Registrar entrada al full">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end" name="Material disponible">
      <bpmn:incoming>f17</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="need" />
    <bpmn:sequenceFlow id="f2" sourceRef="need" targetRef="stock" />
    <bpmn:sequenceFlow id="f3" sourceRef="stock" targetRef="stock_ok" />
    <bpmn:sequenceFlow id="f4" sourceRef="stock_ok" targetRef="stock_end" name="Sí" />
    <bpmn:sequenceFlow id="f5" sourceRef="stock_ok" targetRef="request" name="No" />
    <bpmn:sequenceFlow id="f6" sourceRef="request" targetRef="order" />
    <bpmn:sequenceFlow id="f7" sourceRef="order" targetRef="follow" />
    <bpmn:sequenceFlow id="f8" sourceRef="follow" targetRef="receive" />
    <bpmn:sequenceFlow id="f9" sourceRef="receive" targetRef="qty_ok" />
    <bpmn:sequenceFlow id="f10" sourceRef="qty_ok" targetRef="qty_issue" name="No" />
    <bpmn:sequenceFlow id="f11" sourceRef="qty_issue" targetRef="qty_end" />
    <bpmn:sequenceFlow id="f12" sourceRef="qty_ok" targetRef="quality" name="Sí" />
    <bpmn:sequenceFlow id="f13" sourceRef="quality" targetRef="quality_ok" />
    <bpmn:sequenceFlow id="f14" sourceRef="quality_ok" targetRef="reject" name="No" />
    <bpmn:sequenceFlow id="f15" sourceRef="reject" targetRef="reject_end" />
    <bpmn:sequenceFlow id="f18" sourceRef="quality_ok" targetRef="quality_pending" name="Revisar" />
    <bpmn:sequenceFlow id="f19" sourceRef="quality_pending" targetRef="quality_pending_end" />
    <bpmn:sequenceFlow id="f16" sourceRef="quality_ok" targetRef="register" name="Sí" />
    <bpmn:sequenceFlow id="f17" sourceRef="register" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_AS_IS">
    <bpmndi:BPMNPlane id="Plane_AS_IS" bpmnElement="Process_AS_IS">
