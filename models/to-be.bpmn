    <bpmn:sequenceFlow id="f31" sourceRef="quality_ok" targetRef="quality_pending" name="Revisar" />
    <bpmn:sequenceFlow id="f32" sourceRef="quality_pending" targetRef="quality" />
    <bpmn:sequenceFlow id="f33" sourceRef="quality_ok" targetRef="reject" name="Rebutjar" />
