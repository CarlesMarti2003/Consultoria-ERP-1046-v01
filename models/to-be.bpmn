        <dc:Bounds x="1377" y="371" width="190" height="98"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approval_ok_di" bpmnElement="approval_ok" isMarkerVisible="true" bioc:stroke="#000000" color:border-color="#000000" bioc:fill="#FFFFFF" color:background-color="#FFFFFF">
        <dc:Bounds x="1620" y="395" width="50" height="50"/>
