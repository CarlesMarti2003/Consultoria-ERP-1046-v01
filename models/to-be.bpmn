  <bpmn:process id="Process_TO_BE" name="Aprovisionament millorat" isExecutable="false">
    <bpmn:startEvent id="start" name="Necessitat identificada">

      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="need" name="Registrar necessitat al pla (ERP)">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="calculate" name="Calcular estoc i reposició (ERP)">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="stock_ok" name="Disponible suficient?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="reserve" name="Reservar material (ERP)">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="reorder_check" name="Cal reposar?">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="stock_end" name="Necessitat coberta">
      <bpmn:incoming>f6</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="request" name="Revisar sol·licitud (ERP)">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="approval_ok" name="Decisió?">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="request_correction" name="Corregir petició (ERP)">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="request_rejected" name="Notificar rebuig (ERP)">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="request_end" name="Petició rebutjada">
      <bpmn:incoming>f14</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="supplier" name="Comparar ofertes (ERP)">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="order" name="Emetre comanda (ERP)">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="eta" name="Seguir data i avisar ordres afectades (ERP)">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="date_ok" name="Arriba a temps?">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="delay_response" name="Reclamar, buscar alternativa o replanificar (ERP)">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="alternative_needed" name="Canvi de proveïdor?">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="receive" name="Registrar recepció contra comanda (ERP)">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="qty_ok" name="Recepció?">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
      <bpmn:outgoing>f25</bpmn:outgoing>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="qty_issue" name="Bloquejar i reclamar (ERP)">
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:outgoing>f28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="qty_end" name="Incidència derivada">
      <bpmn:incoming>f28</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="partial" name="Registrar part rebuda i saldo pendent (ERP)">
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="quality" name="Inspeccionar lot (ERP)">
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:incoming>f32</bpmn:incoming>
      <bpmn:outgoing>f29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="quality_ok" name="Decisió de qualitat?">
      <bpmn:incoming>f29</bpmn:incoming>
      <bpmn:outgoing>f30</bpmn:outgoing>
      <bpmn:outgoing>f31</bpmn:outgoing>
      <bpmn:outgoing>f33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="reject" name="Bloquejar lot, avisar ordres i reclamar (ERP)">
      <bpmn:incoming>f33</bpmn:incoming>
      <bpmn:outgoing>f34</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="reject_end" name="Lot rebutjat">
      <bpmn:incoming>f34</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="quality_pending" name="Bloquejar lot, avisar ordres i completar proves (ERP)">
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:outgoing>f32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="register" name="Actualitzar estoc i avisar (ERP)">
      <bpmn:incoming>f30</bpmn:incoming>
      <bpmn:outgoing>f35</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="Material acceptat registrat">
      <bpmn:incoming>f35</bpmn:incoming>

    </bpmn:endEvent>
