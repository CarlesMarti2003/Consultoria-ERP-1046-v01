    <bpmn:sequenceFlow id="f14" sourceRef="request_rejected" targetRef="request_end" />
    <bpmn:sequenceFlow id="f15" sourceRef="supplier" targetRef="order" />
    <bpmn:sequenceFlow id="f16" sourceRef="order" targetRef="eta" />
    <bpmn:sequenceFlow id="f17" sourceRef="eta" targetRef="date_ok" />
