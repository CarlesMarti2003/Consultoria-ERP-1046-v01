        <dc:Bounds x="70" y="40" width="4666" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_purchasing_di" bpmnElement="Lane_purchasing" isHorizontal="true" bioc:stroke="#000000" color:border-color="#000000" bioc:fill="#FFFFFF" color:background-color="#FFFFFF">
        <dc:Bounds x="70" y="220" width="4666" height="400"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_warehouse_di" bpmnElement="Lane_warehouse" isHorizontal="true" bioc:stroke="#000000" color:border-color="#000000" bioc:fill="#FFFFFF" color:background-color="#FFFFFF">
        <dc:Bounds x="70" y="620" width="4666" height="340"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_quality_di" bpmnElement="Lane_quality" isHorizontal="true" bioc:stroke="#000000" color:border-color="#000000" bioc:fill="#FFFFFF" color:background-color="#FFFFFF">
        <dc:Bounds x="70" y="960" width="4666" height="360"/>
      </bpmndi:BPMNShape>
