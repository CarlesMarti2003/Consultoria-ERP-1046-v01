      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="request_end" name="Petició rebutjada">
      <bpmn:incoming>f14</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="supplier" name="Comparar ofertes (ERP)">
