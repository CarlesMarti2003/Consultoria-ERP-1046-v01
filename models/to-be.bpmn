        <dc:Bounds x="1607" y="81" width="190" height="98"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="request_rejected_di" bpmnElement="request_rejected" bioc:stroke="#000000" color:border-color="#000000" bioc:fill="#FFFFFF" color:background-color="#FFFFFF">
        <dc:Bounds x="1837" y="236" width="190" height="98"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="request_end_di" bpmnElement="request_end" bioc:stroke="#000000" color:border-color="#000000" bioc:fill="#FFFFFF" color:background-color="#FFFFFF">
        <dc:Bounds x="2080" y="267" width="36" height="36"/>
        <bpmndi:BPMNLabel color:color="#000000">
          <dc:Bounds x="2040" y="315" width="120" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="supplier_di" bpmnElement="supplier" bioc:stroke="#000000" color:border-color="#000000" bioc:fill="#FFFFFF" color:background-color="#FFFFFF">
