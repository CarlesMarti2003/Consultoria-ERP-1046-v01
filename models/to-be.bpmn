        <dc:Bounds x="1390" y="1367" width="36" height="36"/>
        <bpmndi:BPMNLabel color:color="#000000">
          <dc:Bounds x="1330" y="1411" width="150" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
