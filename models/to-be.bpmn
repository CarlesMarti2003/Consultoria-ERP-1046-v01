        <dc:Bounds x="70" y="1320" width="4666" height="400"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Supplier_di" bpmnElement="Supplier" isHorizontal="true" bioc:stroke="#000000" color:border-color="#000000" bioc:fill="#FFFFFF" color:background-color="#FFFFFF">
