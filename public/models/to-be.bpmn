      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:incoming>f38</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="approval_ok" name="Decisió?">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="request_correction" name="Corregir petició (ERP)">
      <bpmn:documentation>Responsable: Producció i magatzem. Tipus: Tasca d’usuari. Pas: 03. Requisits: HU-03.</bpmn:documentation>
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="request_rejected" name="Notificar rebuig (ERP)">
      <bpmn:documentation>Responsable: Compres. Tipus: Tasca d’usuari. Pas: 03. Requisits: HU-03.</bpmn:documentation>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="request_end" name="Petició rebutjada">
      <bpmn:incoming>f14</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="supplier" name="Comparar ofertes (ERP)">
      <bpmn:documentation>Responsable: Compres. Tipus: Tasca d’usuari. Pas: 04. Requisits: HU-04.</bpmn:documentation>
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:incoming>f37</bpmn:incoming>
      <bpmn:incoming>f39</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="order" name="Emetre comanda (ERP)">
