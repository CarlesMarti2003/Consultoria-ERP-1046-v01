      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="stock_end" name="Necessitat coberta">
      <bpmn:incoming>f6</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="request" name="Revisar sol·licitud (ERP)">
