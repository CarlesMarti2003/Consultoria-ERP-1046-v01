  <bpmn:process id="Process_TO_BE" name="Aprovisionament millorat" isExecutable="false">
<bpmn:laneSet id="LaneSet_TO_BE"><bpmn:lane id="Lane_production" name="Producció"><bpmn:flowNodeRef>start</bpmn:flowNodeRef><bpmn:flowNodeRef>need</bpmn:flowNodeRef><bpmn:flowNodeRef>request_correction</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_purchasing" name="Compres"><bpmn:flowNodeRef>request</bpmn:flowNodeRef><bpmn:flowNodeRef>approval_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>request_rejected</bpmn:flowNodeRef><bpmn:flowNodeRef>request_end</bpmn:flowNodeRef><bpmn:flowNodeRef>supplier</bpmn:flowNodeRef><bpmn:flowNodeRef>delay_response</bpmn:flowNodeRef><bpmn:flowNodeRef>alternative_needed</bpmn:flowNodeRef><bpmn:flowNodeRef>offer_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>cancel_order</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_warehouse" name="Magatzem"><bpmn:flowNodeRef>receive</bpmn:flowNodeRef><bpmn:flowNodeRef>qty_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>qty_issue</bpmn:flowNodeRef><bpmn:flowNodeRef>qty_end</bpmn:flowNodeRef><bpmn:flowNodeRef>partial</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef><bpmn:flowNodeRef>locate</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_quality" name="Qualitat"><bpmn:flowNodeRef>quality</bpmn:flowNodeRef><bpmn:flowNodeRef>quality_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>reject</bpmn:flowNodeRef><bpmn:flowNodeRef>reject_end</bpmn:flowNodeRef><bpmn:flowNodeRef>quality_pending</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_erp" name="Suport ERP"><bpmn:flowNodeRef>calculate</bpmn:flowNodeRef><bpmn:flowNodeRef>stock_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>reserve</bpmn:flowNodeRef><bpmn:flowNodeRef>reorder_check</bpmn:flowNodeRef><bpmn:flowNodeRef>stock_end</bpmn:flowNodeRef><bpmn:flowNodeRef>order</bpmn:flowNodeRef><bpmn:flowNodeRef>eta</bpmn:flowNodeRef><bpmn:flowNodeRef>date_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>register</bpmn:flowNodeRef><bpmn:flowNodeRef>reserve_partial</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="start" name="Necessitat identificada">

      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="need" name="Registrar necessitat al pla (ERP)">
      <bpmn:documentation>Responsable: Producció. Tipus: Tasca d’usuari. Pas: 01. Requisits: HU-01.</bpmn:documentation>
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="calculate" name="Calcular disponible i proposta (ERP)">
