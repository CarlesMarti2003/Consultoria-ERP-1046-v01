      <bpmn:incoming>f36</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="eta" name="Seguir data i avisar ordres afectades (ERP)">
      <bpmn:documentation>Responsable: Compres i producció / ERP. Tipus: Tasca de servei. Pas: 05. Requisits: HU-05.</bpmn:documentation>
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="date_ok" name="Data compatible amb el pla?">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="delay_response" name="Reclamar, buscar alternativa o replanificar (ERP)">
      <bpmn:documentation>Responsable: Compres i producció. Tipus: Tasca d’usuari. Pas: 05. Requisits: HU-11.</bpmn:documentation>
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="alternative_needed" name="Canvi de proveïdor?">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="receive" name="Registrar recepció contra comanda (ERP)">
      <bpmn:documentation>Responsable: Magatzem. Tipus: Tasca d’usuari. Pas: 06. Requisits: HU-06.</bpmn:documentation>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="qty_ok" name="Recepció?">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
      <bpmn:outgoing>f25</bpmn:outgoing>
      <bpmn:outgoing>f27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="qty_issue" name="Bloquejar i reclamar (ERP)">
      <bpmn:documentation>Responsable: Magatzem i compres. Tipus: Tasca d’usuari. Pas: 06. Requisits: HU-06.</bpmn:documentation>
      <bpmn:incoming>f27</bpmn:incoming>
      <bpmn:outgoing>f28</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="qty_end" name="Incidència derivada">
      <bpmn:incoming>f28</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="partial" name="Registrar part rebuda i saldo pendent (ERP)">
      <bpmn:documentation>Responsable: Magatzem. Tipus: Tasca d’usuari. Pas: 06. Requisits: HU-06.</bpmn:documentation>
      <bpmn:incoming>f25</bpmn:incoming>
      <bpmn:outgoing>f26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="quality" name="Inspeccionar lot (ERP)">
      <bpmn:documentation>Responsable: Qualitat. Tipus: Tasca d’usuari. Pas: 07. Requisits: HU-07.</bpmn:documentation>
      <bpmn:incoming>f24</bpmn:incoming>
      <bpmn:incoming>f26</bpmn:incoming>
      <bpmn:incoming>f32</bpmn:incoming>
      <bpmn:outgoing>f29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="quality_ok" name="Decisió de qualitat?">
