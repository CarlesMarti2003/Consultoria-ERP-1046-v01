      <bpmn:outgoing>f30</bpmn:outgoing>
      <bpmn:outgoing>f31</bpmn:outgoing>
      <bpmn:outgoing>f33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="reject" name="Bloquejar lot, avisar ordres i reclamar (ERP)">
      <bpmn:documentation>Responsable: Qualitat i compres. Tipus: Tasca d’usuari. Pas: 07. Requisits: HU-05, HU-07.</bpmn:documentation>
      <bpmn:incoming>f33</bpmn:incoming>
      <bpmn:outgoing>f34</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="reject_end" name="Lot rebutjat">
      <bpmn:incoming>f34</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="quality_pending" name="Bloquejar lot, avisar ordres i completar proves (ERP)">
      <bpmn:documentation>Responsable: Qualitat. Tipus: Tasca d’usuari. Pas: 07. Requisits: HU-05, HU-07.</bpmn:documentation>
      <bpmn:incoming>f31</bpmn:incoming>
      <bpmn:outgoing>f32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="register" name="Actualitzar estoc i avisar (ERP)">
