<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_TO_BE" targetNamespace="https://nexe.example/processos">
  <bpmn:process id="Process_TO_BE" name="Aprovisionament millorat" isExecutable="false">
    <bpmn:startEvent id="start" name="Pla confirmat">

      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="need" name="Registrar necessitat al pla (ERP)">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="calculate" name="Calcular estoc i reposició (ERP)">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="stock_ok" name="Disponible suficient?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="reserve" name="Reservar material (ERP)">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="stock_end" name="Material reservat">
      <bpmn:incoming>f5</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="request" name="Aprovar sol·licitud (ERP)">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="approval_ok" name="Sol·licitud aprovada?">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="request_issue" name="Retornar o rebutjar petició (ERP)">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="request_end" name="Petició no aprovada">
      <bpmn:incoming>f22</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="supplier" name="Comparar ofertes (ERP)">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="order" name="Emetre comanda (ERP)">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="eta" name="Seguir data i avisar riscos (ERP)">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="receive" name="Registrar recepció contra comanda (ERP)">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="qty_ok" name="Quantitat correcta?">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="qty_issue" name="Obrir incidència (ERP)">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="qty_end" name="Pendent de regularitzar">
      <bpmn:incoming>f13</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="quality" name="Inspeccionar lot (ERP)">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="quality_ok" name="Lot acceptat?">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="reject" name="Bloquejar lot i avisar (ERP)">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="reject_end" name="Lot rebutjat">
      <bpmn:incoming>f17</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="quality_pending" name="Mantindre lot en revisió (ERP)">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="quality_pending_end" name="Pendent de qualitat">
      <bpmn:incoming>f24</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:serviceTask id="register" name="Actualitzar estoc i avisar (ERP)">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end" name="Material disponible">
      <bpmn:incoming>f19</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="need" />
    <bpmn:sequenceFlow id="f2" sourceRef="need" targetRef="calculate" />
    <bpmn:sequenceFlow id="f3" sourceRef="calculate" targetRef="stock_ok" />
    <bpmn:sequenceFlow id="f4" sourceRef="stock_ok" targetRef="reserve" name="Sí" />
    <bpmn:sequenceFlow id="f5" sourceRef="reserve" targetRef="stock_end" />
    <bpmn:sequenceFlow id="f6" sourceRef="stock_ok" targetRef="request" name="No" />
    <bpmn:sequenceFlow id="f7" sourceRef="request" targetRef="approval_ok" />
    <bpmn:sequenceFlow id="f20" sourceRef="approval_ok" targetRef="supplier" name="Sí" />
    <bpmn:sequenceFlow id="f21" sourceRef="approval_ok" targetRef="request_issue" name="No" />
    <bpmn:sequenceFlow id="f22" sourceRef="request_issue" targetRef="request_end" />
    <bpmn:sequenceFlow id="f8" sourceRef="supplier" targetRef="order" />
    <bpmn:sequenceFlow id="f9" sourceRef="order" targetRef="eta" />
    <bpmn:sequenceFlow id="f10" sourceRef="eta" targetRef="receive" />
    <bpmn:sequenceFlow id="f11" sourceRef="receive" targetRef="qty_ok" />
    <bpmn:sequenceFlow id="f12" sourceRef="qty_ok" targetRef="qty_issue" name="No" />
    <bpmn:sequenceFlow id="f13" sourceRef="qty_issue" targetRef="qty_end" />
    <bpmn:sequenceFlow id="f14" sourceRef="qty_ok" targetRef="quality" name="Sí" />
    <bpmn:sequenceFlow id="f15" sourceRef="quality" targetRef="quality_ok" />
    <bpmn:sequenceFlow id="f16" sourceRef="quality_ok" targetRef="reject" name="No" />
    <bpmn:sequenceFlow id="f17" sourceRef="reject" targetRef="reject_end" />
    <bpmn:sequenceFlow id="f18" sourceRef="quality_ok" targetRef="register" name="Sí" />
    <bpmn:sequenceFlow id="f19" sourceRef="register" targetRef="end" />
    <bpmn:sequenceFlow id="f23" sourceRef="quality_ok" targetRef="quality_pending" name="Revisar" />
    <bpmn:sequenceFlow id="f24" sourceRef="quality_pending" targetRef="quality_pending_end" />
  </bpmn:process>
